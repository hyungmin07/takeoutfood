PORT=3000

# 매장 관리자 화면(/store.html)에 접속할 때 필요한 비밀번호예요.
# 설정하지 않으면 기본값 0000이 사용되니 꼭 바꿔서 사용하세요.
ADMIN_PASSWORD=0000

# Firebase 프로젝트의 서비스 계정 JSON을 한 줄 문자열로 넣으면
# 주문이 Firestore에 저장돼요. 비워두면 서버 메모리에만 임시 저장됩니다.
FIREBASE_SERVICE_ACCOUNT_JSON=

# 아래는 매장 PC에서 print-agent(npm run print-agent)를 실행할 때만 필요해요.

# 손님이 접속하는 주문 서버 주소예요. 배포 전에는 매장 PC에서 서버도 같이 켜뒀다면
# http://localhost:3000 로 두면 되고, 클라우드에 배포했다면 그 주소(https://...)로 바꿔주세요.
STORE_SERVER_URL=http://localhost:3000

# 매장 영수증 프린터의 IP 주소예요. OK포스 프린터 설정 메뉴나 공유기 관리 페이지에서 확인할 수 있어요.
PRINTER_IP=

# 대부분의 영수증 프린터는 9100번 포트를 사용해요. 다르게 설정되어 있다면 바꿔주세요.
PRINTER_PORT=9100
